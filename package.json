{
  "name": "lotto",
  "version": "0.1.0",
  "private": true,
  "description": "Lotto — offline-draw game tracker for 110 players + 1 admin (MERN + TypeScript monorepo)",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev --workspace=@lotto/server\" \"npm run dev --workspace=@lotto/web\"",
    "dev:server": "npm run dev --workspace=@lotto/server",
    "dev:web": "npm run dev --workspace=@lotto/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "backup": "node ./scripts/backup.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}
