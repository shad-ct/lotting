# ---- Lotto env (see docs/02_BACKEND_API_REALTIME.md section 10) ----
NODE_ENV=development

# Server
PORT=3001
MONGO_URI=mongodb://localhost:27017/lotto
JWT_SECRET=change-me-to-a-long-random-secret
# JWT expiry is fixed at 12h per spec; override only for tests
JWT_EXPIRES_IN=12h
CARD_HMAC_SECRET=change-me-to-a-second-long-random-secret

# Seeded single admin (created at boot if none exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# CORS / links printed on cards and WhatsApp messages
WEB_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
DEFAULT_COUNTRY_CODE=91
